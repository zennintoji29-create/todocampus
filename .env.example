# --- CampusOS environment template -------------------------------------------
# Copy to `.env` and fill from Supabase -> Project Settings -> API.
# Only the PUBLIC anon key belongs in a frontend. NEVER place the
# service_role key here: it bypasses RLS and would expose every user's data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional comma separated emails that an existing admin may promote.
# Listing an email here does NOT grant privileges by itself.
VITE_BOOTSTRAP_ADMIN_EMAILS=
